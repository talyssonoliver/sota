# AI Agent System Environment Configuration
# Copy this file to .env and fill in your values

# Required API Keys
OPENAI_API_KEY=your_openai_api_key_here

# Memory Engine Security (REQUIRED)
# Generate a new encryption key with: python scripts/generate_memory_key.py  
# SECURITY WARNING: Use a unique key for each environment (dev/staging/prod)
# NEVER commit actual keys to version control
MEMORY_ENGINE_KEY=REPLACE_WITH_GENERATED_32_BYTE_BASE64_KEY

# Optional External Integrations
VERCEL_TOKEN=your_vercel_token_here
VERCEL_TEAM_ID=your_vercel_team_id_here
VERCEL_PROJECT_ID=your_vercel_project_id_here

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key_here

GITHUB_TOKEN=your_github_token_here

# Optional: Slack notifications
SLACK_WEBHOOK_URL=your_slack_webhook_url_here

# Optional: LangSmith tracing
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=your_project_name_here

# System Configuration
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
ANONYMIZED_TELEMETRY=false

# Database and Service Passwords (REQUIRED for docker-compose)
# SECURITY: Use strong, unique passwords for each environment
POSTGRES_PASSWORD=your_secure_postgres_password_here
REDIS_PASSWORD=your_secure_redis_password_here
GRAFANA_PASSWORD=your_secure_grafana_password_here
JUPYTER_TOKEN=your_secure_jupyter_token_here
