{
  "hooks": [
    {
      "event": "PreToolUse",
      "matcher": {
        "tool": "str_replace_editor"
      },
      "command": "echo '🔍 INVESTIGATION MODE: Remember to investigate before fixing!' && echo 'File: $CLAUDE_FILE_PATHS'",
      "run_in_background": false
    },
    {
      "event": "PostToolUse",
      "matcher": {
        "tool": "str_replace_editor",
        "file_extensions": [".py"]
      },
      "command": "cd /mnt/c/taly/ai-system && echo '📝 Checking changes to: $CLAUDE_FILE_PATHS' && python3 -m ruff check $CLAUDE_FILE_PATHS || true",
      "run_in_background": false
    },
    {
      "event": "TaskCompletion",
      "command": "echo '✅ Investigation task completed. Remember: DO NOT auto-fix F401/F841 without investigation!'",
      "run_in_background": false
    }
  ],
  "pre_session": {
    "description": "Initialize AI system environment before Claude Code session",
        "commands": [
          {
            "name": "set_pythonpath",
            "command": "export PYTHONPATH=/mnt/c/taly/ai-system:$PYTHONPATH",
            "description": "Set Python path for AI system"
          },
          {
            "name": "check_system_health",
            "command": "python3 -c \"from src.infrastructure.memory.engines.memory_engine import MemoryEngine; print('✅ Memory Engine: Ready')\"",
            "description": "Quick health check of core systems",
            "continue_on_error": true
          }
        ]
  },
  "post_session": {
        "description": "Cleanup and reporting after Claude Code session",
        "commands": [
          {
            "name": "session_summary",
            "command": "echo '📊 Session completed at: $(date)'",
            "description": "Log session completion"
          },
          {
            "name": "git_status_check",
            "command": "git status --short",
            "description": "Show any uncommitted changes",
            "continue_on_error": true
          }
        ]
  },
  "pre_commit": {
      "description": "Quality checks before committing code",
      "commands": [
        {
          "name": "format_code",
          "command": "python3 -m black .",
          "description": "Auto-format Python code with Black"
        },
        {
          "name": "sort_imports",
          "command": "python3 -m isort .",
          "description": "Sort and organize imports"
        },
        {
          "name": "type_check",
          "command": "python3 -m mypy src/ --ignore-missing-imports --show-error-codes",
          "description": "Run type checking",
          "continue_on_error": true
        },
        {
          "name": "lint_check",
          "command": "python3 -m ruff check src/ tests/",
          "description": "Run linting checks",
          "continue_on_error": true
        },
        {
          "name": "security_scan",
          "command": "python3 -m bandit -r src/ -f json -o .tmp/security-report.json",
          "description": "Security vulnerability scan",
          "continue_on_error": true
        }
      ]
    },
    "post_commit": {
      "description": "Actions after successful commit",
      "commands": [
        {
          "name": "commit_confirmation",
          "command": "echo '✅ Commit successful: $(git log -1 --oneline)'",
          "description": "Show commit confirmation"
        },
        {
          "name": "update_changelog",
          "command": "echo '$(date): $(git log -1 --oneline)' >> CHANGELOG.auto.md",
          "description": "Auto-update changelog",
          "continue_on_error": true
        }
      ]
    },
    "pre_test": {
      "description": "Setup before running tests",
      "commands": [
        {
          "name": "setup_test_env",
          "command": "export TESTING=1 && export PYTHONPATH=/mnt/c/taly/ai-system:$PYTHONPATH",
          "description": "Set testing environment variables"
        },
        {
          "name": "create_test_dirs",
          "command": "mkdir -p test_outputs logs runtime/cache",
          "description": "Ensure test directories exist"
        }
      ]
    },
    "post_test": {
      "description": "Cleanup and reporting after tests",
      "commands": [
        {
          "name": "test_summary",
          "command": "echo '🧪 Test run completed at: $(date)'",
          "description": "Log test completion"
        },
        {
          "name": "coverage_report",
          "command": "python3 -m coverage report --show-missing",
          "description": "Show test coverage report",
          "continue_on_error": true
        },
        {
          "name": "cleanup_temp_files",
          "command": "find . -name '*.pyc' -delete && find . -name '__pycache__' -type d -exec rm -rf {} + 2>/dev/null || true",
          "description": "Clean up temporary Python files"
        }
      ]
  },
  "pre_build": {
      "description": "Preparation before building/deploying",
      "commands": [
        {
          "name": "validate_config",
          "command": "python3 -c \"import yaml; yaml.safe_load(open('config/agents.yaml')); print('✅ Config valid')\"",
          "description": "Validate configuration files"
        },
        {
          "name": "check_dependencies",
          "command": "python3 -m pip check",
          "description": "Check for dependency conflicts",
          "continue_on_error": true
        }
      ]
  },
  "post_build": {
      "description": "Actions after successful build",
      "commands": [
        {
          "name": "build_confirmation",
          "command": "echo '🏗️ Build completed successfully at: $(date)'",
          "description": "Confirm build completion"
        },
        {
          "name": "validate_deployment",
          "command": "python3 -c \"from src.core.agents.factory import create_backend_agent; print('✅ Deployment validation passed')\"",
          "description": "Quick deployment validation"
        }
      ]
  },
  "on_file_change": {
      "description": "Actions when files are modified",
      "file_patterns": ["*.py", "*.yaml", "*.json"],
      "commands": [
        {
          "name": "auto_format_python",
          "command": "python3 -m black $CHANGED_FILE",
          "description": "Auto-format changed Python files",
          "file_pattern": "*.py",
          "continue_on_error": true
        },
        {
          "name": "validate_yaml",
          "command": "python3 -c \"import yaml; yaml.safe_load(open('$CHANGED_FILE')); print('✅ YAML valid')\"",
          "description": "Validate YAML syntax",
          "file_pattern": "*.yaml",
          "continue_on_error": true
        },
        {
          "name": "validate_json",
          "command": "python3 -c \"import json; json.load(open('$CHANGED_FILE')); print('✅ JSON valid')\"",
          "description": "Validate JSON syntax", 
          "file_pattern": "*.json",
          "continue_on_error": true
        }
      ]
  },
  "on_error": {
      "description": "Error handling and recovery",
      "commands": [
        {
          "name": "log_error",
          "command": "echo '[ERROR] $(date): $ERROR_MESSAGE' >> logs/errors.log",
          "description": "Log error to file"
        },
        {
          "name": "create_backup",
          "command": "git stash push -m 'Error recovery backup $(date +%Y%m%d_%H%M%S)'",
          "description": "Create git stash backup",
          "continue_on_error": true
        },
        {
          "name": "system_status",
          "command": "python3 -c \"print('🏥 System Status:'); import sys; print(f'Python: {sys.version}'); print(f'Working dir: $(pwd)')\"",
          "description": "Show system status for debugging"
        }
      ]
  },
  "settings": {
    "timeout": 30,
    "max_retries": 2,
    "parallel_execution": false,
    "log_output": true,
    "log_file": "logs/hooks.log",
    "enable_colors": true,
    "continue_on_hook_failure": true,
    "environment_variables": {
      "PYTHONPATH": "/mnt/c/taly/ai-system",
      "AI_SYSTEM_ROOT": "/mnt/c/taly/ai-system",
      "TESTING": "0"
    }
  },
  "ai_system_integration": {
    "memory_engine": {
      "auto_context_injection": true,
      "context_domains": ["backend_engineering", "frontend_development", "qa_testing"],
      "pre_execution_context": true
    },
    "workflow_engine": {
      "auto_task_validation": true,
      "dependency_checking": true,
      "output_validation": true
    },
    "agent_coordination": {
      "health_checks": true,
      "load_balancing": false,
      "failure_recovery": true
    }
  }
}