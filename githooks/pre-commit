#!/bin/bash
# Pre-commit hook to prevent accumulation of generated files
# This hook ensures we don't commit files that should be generated during CI/CD

set -e

echo "🔍 Pre-commit: Checking for generated files..."

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

# Function to check if files exist and warn/block
check_generated_files() {
    local files_to_check=(
        ".coverage*"
        "coverage.xml"
        "htmlcov/"
        "bandit-report.json"
        "*_ruff_report.json"
        "core_ruff_report.json"
        "infrastructure_ruff_report.json"
    )
    
    local found_files=()
    
    for pattern in "${files_to_check[@]}"; do
        # Use find to check for files matching the pattern
        if [[ "$pattern" == *"*"* ]]; then
            # Handle wildcard patterns
            if find . -maxdepth 1 -name "$pattern" 2>/dev/null | grep -q .; then
                found_files+=("$pattern")
            fi
        else
            # Handle exact filenames and directories
            if [[ -e "$pattern" ]]; then
                found_files+=("$pattern")
            fi
        fi
    done
    
    if [[ ${#found_files[@]} -gt 0 ]]; then
        echo -e "${RED}❌ Found generated files that should not be committed:${NC}"
        for file in "${found_files[@]}"; do
            echo -e "  ${RED}• $file${NC}"
        done
        echo ""
        echo -e "${YELLOW}💡 Run 'make clean-artifacts' to clean these files${NC}"
        echo -e "${YELLOW}💡 These files are automatically generated and should not be committed${NC}"
        return 1
    fi
    
    return 0
}

# Function to clean Python cache files
clean_python_caches() {
    echo "🧹 Cleaning Python cache files..."
    
    # Remove __pycache__ directories
    find . -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true
    
    # Remove .pyc files
    find . -type f -name "*.pyc" -delete 2>/dev/null || true
    
    echo -e "${GREEN}✅ Python caches cleaned${NC}"
}

# Function to clean tool caches
clean_tool_caches() {
    echo "🛠️  Cleaning tool caches..."
    
    # Only clean if caches are large (> 10MB)
    if [[ -d ".ruff_cache" ]]; then
        cache_size=$(du -sm .ruff_cache 2>/dev/null | cut -f1 || echo "0")
        if [[ $cache_size -gt 10 ]]; then
            echo "  Cleaning large .ruff_cache ($cache_size MB)"
            rm -rf .ruff_cache/
        fi
    fi
    
    if [[ -d ".mypy_cache" ]]; then
        cache_size=$(du -sm .mypy_cache 2>/dev/null | cut -f1 || echo "0")
        if [[ $cache_size -gt 10 ]]; then
            echo "  Cleaning large .mypy_cache ($cache_size MB)"
            rm -rf .mypy_cache/
        fi
    fi
    
    echo -e "${GREEN}✅ Tool caches checked and cleaned if needed${NC}"
}

# Main execution
main() {
    # Always clean Python caches (they accumulate quickly)
    clean_python_caches
    
    # Clean tool caches if they're large
    clean_tool_caches
    
    # Check for generated files that shouldn't be committed
    if ! check_generated_files; then
        echo ""
        echo -e "${RED}❌ Pre-commit check failed!${NC}"
        echo -e "${YELLOW}Please clean the generated files and try again.${NC}"
        exit 1
    fi
    
    echo -e "${GREEN}✅ Pre-commit checks passed!${NC}"
}

# Run main function
main "$@"