{
  "python.defaultInterpreterPath": "./.venv/Scripts/python.exe",
  "python.linting.enabled": true,
  "python.linting.ruffEnabled": true,
  "python.formatting.provider": "black",
  "editor.formatOnSave": true,
  "python.testing.pytestEnabled": false,
  "python.testing.pytestArgs": ["tests"],
  "editor.codeActionsOnSave": {
  "source.organizeImports": "explicit",
  "source.fixAll": "explicit"
  },
  "python.testing.unittestArgs": [
    "-v",
    "-s",
    ".",
    "-p",
    "test_*.py"
  ],
  "python.testing.unittestEnabled": true,
  
  // Pylance Performance Optimization Settings
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.indexing": true,
  "python.analysis.packageIndexDepths": [
    {
      "name": "",
      "depth": 8,
      "includeAllSymbols": false
    }
  ],
  
  // Reduce CPU-intensive analysis
  "python.analysis.autoSearchPaths": false,
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.stubPath": "./typings",
  
  // Memory and performance limits
  "python.analysis.userFileIndexingLimit": 2000,
  "python.analysis.extraPaths": ["./src"],
  
  // Exclude heavy directories from analysis
  "python.analysis.exclude": [
    "**/node_modules/**",
    "**/__pycache__/**",
    "**/.*/**",
    "**/build/**",
    "**/dist/**",
    "**/logs/**",
    "**/test_logs/**",
    "**/test_outputs/**",
    "**/outputs/**",
    "**/deployment/**",
    "**/backup/**",
    "**/htmlcov/**",
    "**/data/**",
    "**/storage/**"
  ],
  
  // Reduce IntelliSense overhead
  "python.analysis.completeFunctionParens": false,
  "python.analysis.inlayHints.functionReturnTypes": false,
  "python.analysis.inlayHints.variableTypes": false,
  "python.analysis.inlayHints.pytestParameters": false,
  
  // Disable expensive features for large codebases
  "python.analysis.importFormat": "relative",
  "python.analysis.fixAll": [],
  
  // General VS Code performance settings
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "off"
  },
  "editor.suggestSelection": "first",
  "editor.acceptSuggestionOnCommitCharacter": false,
  
  // File watcher performance
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/tmp/**": true,
    "**/__pycache__/**": true,
    "**/logs/**": true,
    "**/test_logs/**": true,
    "**/test_outputs/**": true,
    "**/outputs/**": true,
    "**/htmlcov/**": true,
    "**/data/storage/**": true
  },
  
  // Search exclusions for better performance
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/__pycache__": true,
    "**/logs": true,
    "**/test_logs": true,
    "**/test_outputs": true,
    "**/outputs": true,
    "**/htmlcov": true,
    "**/data/storage": true,
    "**/backup": true
  }
}
