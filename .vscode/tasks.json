{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Quick Tests (Parallel)",
      "type": "shell", 
      "command": "python",
      "args": ["-m", "tests.enhanced_test_runner", "--quick", "--verbose"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": true
      },
      "problemMatcher": {
        "owner": "pytest",
        "pattern": {
          "regexp": "^(.*):(\\d+):\\s+(.*?)\\s+(FAILED|ERROR)",
          "file": 1,
          "line": 2,
          "message": 3
        }
      }
    },
